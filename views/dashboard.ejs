<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container">
    <h1><%= examName %></h1>
    <p class="subtitle">Collection period: <%= collectionStart %> to <%= collectionEnd %> · <%= totalCases %> case<%= totalCases === 1 ? '' : 's' %> logged</p>

    <% bySection.forEach(function(group) { %>
      <div class="section-header"><h2><%= group.section %><%= group.section === 'Office Practice' ? ' (' + group.sectionTotal + ' total)' : '' %></h2></div>
      <% if (group.section === 'Office Practice') { %>
        <p class="section-note">Per research (not a direct bulletin read — verify against your current ABOG Bulletin): minimum 30, maximum 40 total Office Practice patients, no more than 2 per category, and not every category needs an entry. Each square's "/2" below is that per-category cap, not a minimum.</p>
      <% } %>
      <div class="progress-grid">
        <% group.items.forEach(function(item) { %>
          <div class="progress-item">
            <a href="/cases/new?category_id=<%= item.id %>" class="add-case-dot" title="Add a case in <%= item.name %>">+</a>
            <div class="label">
              <span><%= item.name %></span>
              <span class="count"><%= item.count %><%= item.minimum_count > 0 ? ' / ' + item.minimum_count : '' %></span>
            </div>
            <% if (item.minimum_count > 0) { %>
              <div class="progress-bar">
                <div class="progress-bar-fill <%= item.pct >= 100 ? 'complete' : '' %>" style="width: <%= item.pct %>%"></div>
              </div>
            <% } else { %>
              <div class="no-min">No minimum set</div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% }); %>

    <div class="section-header"><h2>Recently added</h2><a href="/cases" class="small">View all cases →</a></div>
    <div class="card">
      <% if (recentCases.length === 0) { %>
        <div class="empty-state">
          <p>No cases yet.</p>
          <a href="/cases/new" class="btn">Add your first case</a>
        </div>
      <% } else { %>
      <table>
        <thead><tr><th>Date</th><th>Category</th><th>Initials</th><th>Procedure</th><th></th></tr></thead>
        <tbody>
          <% recentCases.forEach(function(c) { %>
          <tr>
            <td><%= c.date_of_service || '—' %></td>
            <td><%= c.category_name || '—' %></td>
            <td><%= c.patient_initials || '—' %></td>
            <td><%= c.procedure_text || '—' %></td>
            <td><a href="/cases/<%= c.id %>">View</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
  <footer class="app-footer">Private tool · de-identify all entries before saving · verify official requirements at abog.org</footer>
</body>
</html>
