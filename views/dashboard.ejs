<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container">
    <h1><%= examName %></h1>
    <p class="subtitle">Collection period: <%= collectionStart %> to <%= collectionEnd %> · <%= totalCases %> case<%= totalCases === 1 ? '' : 's' %> logged</p>

    <% bySection.forEach(function(group) { %>
      <div class="section-header">
        <h2><%= group.section %></h2>
        <span style="display:flex; align-items:center; gap:14px;">
          <a href="/cases/report/<%= encodeURIComponent(group.section) %>" class="small">View as ABOG list →</a>
          <% if (group.minimum) { %>
            <span class="count"><%= group.effectiveCount %> / <%= group.minimum %> counted<%= group.met ? ' — minimum met' : '' %></span>
          <% } %>
        </span>
      </div>
      <% if (group.minimum) { %>
        <div class="progress-bar" style="margin-bottom:10px;">
          <div class="progress-bar-fill <%= group.met ? 'complete' : '' %>" style="width: <%= group.pct %>%"></div>
        </div>
        <p class="small muted" style="margin-top:-4px;">Max <%= group.maxPerCategory %> patients per category count toward this minimum — every patient still needs to be listed, extra cases in one category just don't add to the total.</p>
      <% } %>
      <% if (group.guidelines) { %>
        <details class="note-box" style="margin-bottom:16px;">
          <summary style="cursor:pointer; font-weight:600;">Guidelines from ABOG's case list page</summary>
          <ul class="small" style="margin-top:10px;">
            <% group.guidelines.forEach(function(g) { %><li><%= g %></li><% }); %>
          </ul>
          <% if (group.exclusionNote) { %>
            <p class="small" style="margin-top:10px;"><strong><%= group.exclusionNote.heading %></strong></p>
            <ul class="small">
              <% group.exclusionNote.items.forEach(function(g) { %><li><%= g %></li><% }); %>
            </ul>
          <% } %>
        </details>
      <% } %>
      <div class="progress-grid">
        <% group.items.forEach(function(item) { %>
          <div class="progress-item">
            <button type="button" class="qa-plus" title="Add a patient to <%= item.name %>"
                    data-category-id="<%= item.id %>" data-category-name="<%= item.name %>"
                    data-next-number="<%= item.count + 1 %>" aria-label="Add patient to <%= item.name %>">+</button>
            <a class="label" href="/cases?category=<%= item.id %>">
              <span class="progress-item-name"><%= item.name %></span>
              <span class="count"><%= item.count %><%= item.minimum_count > 0 ? ' / ' + item.minimum_count : '' %></span>
            </a>
            <% if (item.overCap) { %>
              <div class="no-min">Only <%= group.maxPerCategory %> of these <%= item.count %> count toward the minimum</div>
            <% } else if (item.minimum_count > 0) { %>
              <div class="progress-bar">
                <div class="progress-bar-fill <%= item.pct >= 100 ? 'complete' : '' %>" style="width: <%= item.pct %>%"></div>
              </div>
            <% } else if (!group.minimum) { %>
              <div class="no-min">No minimum set</div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% }); %>

    <div class="section-header"><h2>Recently added</h2><a href="/cases" class="small">View all cases →</a></div>
    <div class="card">
      <% if (recentCases.length === 0) { %>
        <div class="empty-state">
          <p>No cases yet.</p>
          <a href="/cases/new" class="btn">Add your first case</a>
        </div>
      <% } else { %>
      <table>
        <thead><tr><th>Date</th><th>Category</th><th>Patient</th><th>Procedure</th><th></th></tr></thead>
        <tbody>
          <% recentCases.forEach(function(c) { %>
          <tr>
            <td><%= c.date_of_service || '—' %></td>
            <td><%= c.category_name || '—' %></td>
            <td><%= c.patient_ref || c.patient_initials || '—' %></td>
            <td><%= c.procedure_text || '—' %></td>
            <td><a href="/cases/<%= c.id %>">View</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <dialog id="quick-add-modal" class="modal">
    <form method="POST" action="/cases" class="modal-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="category_id" id="qa-category-id" />
      <div class="modal-header">
        <h2 id="qa-category-name">Add patient</h2>
        <button type="button" class="modal-close" id="qa-close" aria-label="Close">&times;</button>
      </div>
      <div class="form-grid">
        <div class="field-group">
          <label for="qa-patient-ref">Patient reference</label>
          <input type="text" id="qa-patient-ref" name="patient_ref" />
        </div>
        <div class="field-group">
          <label for="qa-date">Date of service</label>
          <input type="date" id="qa-date" name="date_of_service" />
        </div>
        <div class="field-group">
          <label for="qa-age">Age</label>
          <input type="number" id="qa-age" name="age" min="0" max="120" />
        </div>
        <div class="field-group">
          <label for="qa-gender">Gender</label>
          <select id="qa-gender" name="gender">
            <option value="">—</option>
            <option value="Female">Female</option>
            <option value="Male">Male</option>
          </select>
        </div>
        <div class="field-group full">
          <label for="qa-diagnosis">Diagnosis</label>
          <input type="text" id="qa-diagnosis" name="diagnosis_text" />
        </div>
        <div class="field-group full">
          <label for="qa-procedure">Procedure / treatment</label>
          <input type="text" id="qa-procedure" name="procedure_text" />
        </div>
        <div class="field-group full">
          <label for="qa-complications">Complications</label>
          <input type="text" id="qa-complications" name="complications" />
        </div>
        <div class="field-group full">
          <label for="qa-notes">Notes</label>
          <textarea id="qa-notes" name="notes" rows="2"></textarea>
        </div>
      </div>
      <p class="small muted">De-identify before saving — no names, MRNs, or full dates of birth. Need more fields (role, setting, gestational age)? <a href="/cases/new">Use the full form</a> instead.</p>
      <div class="actions">
        <button type="submit" class="btn">Save patient</button>
        <button type="button" formmethod="dialog" class="btn btn-secondary" id="qa-cancel">Cancel</button>
      </div>
    </form>
  </dialog>

  <footer class="app-footer">Private tool · de-identify all entries before saving · verify official requirements at abog.org</footer>
  <script src="/js/dashboard.js"></script>
</body>
</html>
