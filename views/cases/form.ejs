<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="container">
    <h1><%= title %></h1>

    <% var isEdit = caseItem && caseItem.id; %>

    <% if (!isEdit) { %>
    <div class="note-box">
      <h3>Quick add from a note</h3>
      <p class="small muted">Paste a note below and click Parse — a short OR-note line, or a full H&amp;P / Assessment &amp; Plan / Problem List. Any line that looks like a name, DOB, MRN, or attending label is dropped automatically before parsing. Review and correct the suggested fields before saving — the note text itself is discarded unless you check "keep note" after parsing.</p>
      <form method="POST" action="/cases/parse">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="field-group">
          <textarea name="source_note" rows="6" placeholder="e.g. Assessment and Plan: 1. Intrauterine pregnancy at 39w2d - proceed with repeat cesarean delivery today. 2. No evidence of hemorrhage or infection postoperatively."><%= sourceNote %></textarea>
        </div>
        <button type="submit" class="btn-secondary">Parse note</button>
      </form>
      <% if (parsed) { %>
        <p class="small" style="margin-top:10px;"><strong>Suggested:</strong></p>
        <ul class="suggestion-list">
          <% Object.keys(parsed).forEach(function(k) { if (parsed[k]) { %>
            <li><%= k %>: <%= parsed[k] %></li>
          <% } }); %>
        </ul>
      <% } %>
    </div>
    <% } %>

    <form method="POST" action="<%= isEdit ? '/cases/' + caseItem.id : '/cases' %>" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="form-grid">
        <div class="field-group">
          <label for="section_select">Section</label>
          <select id="section_select">
            <option value="">Select a section...</option>
            <option value="Obstetrics">Obstetrics</option>
            <option value="Gynecology">Gynecology</option>
            <option value="Office Practice">Office Practice</option>
          </select>
        </div>
        <div class="field-group" id="category_field_group">
          <label for="category_id">Category</label>
          <select id="category_id" name="category_id" required>
            <option value="">Select a category...</option>
            <% var currentSection = null; %>
            <% categories.forEach(function(cat) { %>
              <% if (cat.section !== currentSection) { if (currentSection !== null) { %></optgroup><% } %>
                <optgroup label="<%= cat.section %>">
              <% currentSection = cat.section; } %>
              <option value="<%= cat.id %>" data-section="<%= cat.section %>" <%= String(caseItem.category_id) === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
            <% }); %>
            <% if (currentSection !== null) { %></optgroup><% } %>
          </select>
        </div>
        <div class="field-group">
          <label for="date_of_service">Date of service</label>
          <input type="date" id="date_of_service" name="date_of_service" value="<%= caseItem.date_of_service || '' %>" />
        </div>

        <div class="field-group">
          <label for="patient_initials">Patient initials</label>
          <input type="text" id="patient_initials" name="patient_initials" maxlength="5" value="<%= caseItem.patient_initials || '' %>" placeholder="e.g. J.D." />
        </div>
        <div class="field-group">
          <label for="patient_ref">De-identified patient reference</label>
          <input type="text" id="patient_ref" name="patient_ref" value="<%= caseItem.patient_ref || '' %>" placeholder="internal tracking # only — no MRN" />
        </div>

        <div class="field-group">
          <label for="age">Age</label>
          <input type="number" id="age" name="age" min="0" max="120" value="<%= caseItem.age || '' %>" />
        </div>
        <div class="field-group">
          <label for="gender">Gender</label>
          <select id="gender" name="gender">
            <option value="">—</option>
            <option value="Female" <%= caseItem.gender === 'Female' ? 'selected' : '' %>>Female</option>
            <option value="Male" <%= caseItem.gender === 'Male' ? 'selected' : '' %>>Male</option>
          </select>
        </div>

        <div class="field-group">
          <label for="gravida">Gravida (G)</label>
          <input type="number" id="gravida" name="gravida" min="0" value="<%= caseItem.gravida || '' %>" />
        </div>
        <div class="field-group">
          <label for="para">Para (P)</label>
          <input type="number" id="para" name="para" min="0" value="<%= caseItem.para || '' %>" />
        </div>

        <div class="field-group">
          <label for="setting">Setting</label>
          <select id="setting" name="setting">
            <option value="">—</option>
            <% ['Inpatient','Outpatient','Short-Stay'].forEach(function(s) { %>
              <option value="<%= s %>" <%= caseItem.setting === s ? 'selected' : '' %>><%= s %></option>
            <% }); %>
          </select>
        </div>
        <div class="field-group">
          <label for="role">Role</label>
          <select id="role" name="role">
            <option value="">—</option>
            <% ['Primary Surgeon','First Assistant','Supervised Resident','Attending / Supervising Surgeon'].forEach(function(r) { %>
              <option value="<%= r %>" <%= caseItem.role === r ? 'selected' : '' %>><%= r %></option>
            <% }); %>
          </select>
        </div>

        <div class="field-group section-fields" data-section="Obstetrics">
          <label for="gestational_age">Gestational age</label>
          <input type="text" id="gestational_age" name="gestational_age" placeholder="e.g. 39w2d" value="<%= caseItem.gestational_age || '' %>" />
        </div>
        <div class="field-group section-fields" data-section="Obstetrics">
          <label for="delivery_type">Delivery type</label>
          <select id="delivery_type" name="delivery_type">
            <option value="">—</option>
            <% ['Spontaneous Vaginal','Operative Vaginal (Forceps)','Operative Vaginal (Vacuum)','Cesarean — Primary','Cesarean — Repeat','VBAC'].forEach(function(d) { %>
              <option value="<%= d %>" <%= caseItem.delivery_type === d ? 'selected' : '' %>><%= d %></option>
            <% }); %>
          </select>
        </div>
        <div class="field-group section-fields full" data-section="Obstetrics">
          <label for="complications_antepartum">Complications — antepartum</label>
          <input type="text" id="complications_antepartum" name="complications_antepartum" value="<%= caseItem.complications_antepartum || '' %>" />
        </div>
        <div class="field-group section-fields full" data-section="Obstetrics">
          <label for="complications_delivery_postpartum">Complications — delivery or postpartum</label>
          <input type="text" id="complications_delivery_postpartum" name="complications_delivery_postpartum" value="<%= caseItem.complications_delivery_postpartum || '' %>" />
        </div>
        <div class="field-group section-fields" data-section="Obstetrics">
          <label for="perinatal_death">Perinatal death</label>
          <select id="perinatal_death" name="perinatal_death">
            <option value="">—</option>
            <option value="No" <%= caseItem.perinatal_death === 'No' ? 'selected' : '' %>>No</option>
            <option value="Yes" <%= caseItem.perinatal_death === 'Yes' ? 'selected' : '' %>>Yes</option>
          </select>
        </div>
        <div class="field-group section-fields" data-section="Obstetrics" data-section-also="Gynecology">
          <label for="days_in_hospital">Days in hospital</label>
          <input type="number" id="days_in_hospital" name="days_in_hospital" min="0" value="<%= caseItem.days_in_hospital ?? '' %>" />
        </div>
        <div class="field-group section-fields" data-section="Obstetrics">
          <label for="newborn_weight">Newborn weight</label>
          <input type="text" id="newborn_weight" name="newborn_weight" placeholder="e.g. 3200g, or A: 2225g B: 2420g for twins" value="<%= caseItem.newborn_weight || '' %>" />
        </div>
        <div class="field-group section-fields" data-section="Obstetrics">
          <label for="newborn_apgar">Newborn APGAR (1 &amp; 5 min)</label>
          <input type="text" id="newborn_apgar" name="newborn_apgar" placeholder="e.g. 8-9" value="<%= caseItem.newborn_apgar || '' %>" />
        </div>
        <div class="field-group section-fields" data-section="Obstetrics">
          <label for="newborn_days_in_hospital">Newborn days in hospital</label>
          <input type="text" id="newborn_days_in_hospital" name="newborn_days_in_hospital" value="<%= caseItem.newborn_days_in_hospital || '' %>" />
        </div>

        <div class="field-group section-fields" data-section="Gynecology">
          <label for="surgical_pathology_diagnosis">Surgical pathology diagnosis</label>
          <input type="text" id="surgical_pathology_diagnosis" name="surgical_pathology_diagnosis" value="<%= caseItem.surgical_pathology_diagnosis || '' %>" />
        </div>
        <div class="field-group section-fields" data-section="Gynecology">
          <label for="uterine_weight_g">Uterine weight (g)</label>
          <input type="number" id="uterine_weight_g" name="uterine_weight_g" min="0" value="<%= caseItem.uterine_weight_g ?? '' %>" />
        </div>

        <div class="field-group section-fields" data-section="Gynecology" data-section-also="Office Practice">
          <label for="treatment">Treatment</label>
          <input type="text" id="treatment" name="treatment" value="<%= caseItem.treatment || '' %>" />
        </div>
        <div class="field-group section-fields" data-section="Office Practice">
          <label for="diagnostic_procedures">Diagnostic procedures</label>
          <input type="text" id="diagnostic_procedures" name="diagnostic_procedures" value="<%= caseItem.diagnostic_procedures || '' %>" />
        </div>
        <div class="field-group section-fields" data-section="Office Practice">
          <label for="results">Results</label>
          <input type="text" id="results" name="results" value="<%= caseItem.results || '' %>" />
        </div>
        <div class="field-group section-fields" data-section="Office Practice">
          <label for="visit_count">No. of visits (for this problem)</label>
          <input type="number" id="visit_count" name="visit_count" min="0" value="<%= caseItem.visit_count ?? '' %>" />
        </div>

        <div class="field-group">
          <label for="diagnosis_code">Diagnosis code (ICD-10)</label>
          <input type="text" id="diagnosis_code" name="diagnosis_code" value="<%= caseItem.diagnosis_code || '' %>" />
        </div>
        <div class="field-group">
          <label for="diagnosis_text">Diagnosis description</label>
          <input type="text" id="diagnosis_text" name="diagnosis_text" value="<%= caseItem.diagnosis_text || '' %>" />
        </div>

        <div class="field-group">
          <label for="procedure_code">Procedure code (CPT)</label>
          <input type="text" id="procedure_code" name="procedure_code" value="<%= caseItem.procedure_code || '' %>" />
        </div>
        <div class="field-group">
          <label for="procedure_text">Procedure description</label>
          <input type="text" id="procedure_text" name="procedure_text" value="<%= caseItem.procedure_text || '' %>" />
        </div>

        <div class="field-group full">
          <label for="complications">Complications</label>
          <input type="text" id="complications" name="complications" value="<%= caseItem.complications || '' %>" />
        </div>
        <div class="field-group full">
          <label for="notes">Notes</label>
          <textarea id="notes" name="notes" rows="3"><%= caseItem.notes || '' %></textarea>
        </div>

        <% if (sourceNote) { %>
        <div class="field-group full">
          <label style="display:flex; align-items:center; gap:8px; font-weight:400;">
            <input type="checkbox" name="keep_source_note" style="width:auto;" />
            Keep the original pasted note attached to this case (may contain identifiable text — leave unchecked to discard it)
          </label>
          <textarea name="source_note" rows="3" style="display:none"><%= sourceNote %></textarea>
        </div>
        <% } %>
      </div>

      <div class="actions">
        <button type="submit" class="btn">Save case</button>
        <a href="<%= isEdit ? '/cases/' + caseItem.id : '/cases' %>" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
  <script src="/js/categorySelect.js"></script>
  <script src="/js/caseForm.js"></script>
</body>
</html>
