<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="container">
    <div class="section-header">
      <h1>Case List</h1>
      <a href="/cases/new" class="btn">+ Add Case</a>
    </div>

    <form method="GET" action="/cases" class="filters">
      <input type="text" name="q" placeholder="Search patient, diagnosis, procedure..." value="<%= q %>" />
      <select id="filter_section_select">
        <option value="">All sections</option>
        <option value="Obstetrics">Obstetrics</option>
        <option value="Gynecology">Gynecology</option>
        <option value="Office Practice">Office Practice</option>
      </select>
      <span id="filter_category_wrapper">
        <select name="category" id="filter_category_select">
          <option value="">All categories</option>
          <% var currentSection = null; %>
          <% categories.forEach(function(cat) { %>
            <% if (cat.section !== currentSection) { if (currentSection !== null) { %></optgroup><% } %>
              <optgroup label="<%= cat.section %>">
            <% currentSection = cat.section; } %>
            <option value="<%= cat.id %>" data-section="<%= cat.section %>" <%= String(filterCategory) === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
          <% }); %>
          <% if (currentSection !== null) { %></optgroup><% } %>
        </select>
      </span>
      <button type="submit" class="btn-secondary btn-small">Filter</button>
      <% if (q || filterCategory) { %><a href="/cases" class="btn-small btn-secondary">Clear</a><% } %>
    </form>

    <div class="card">
      <% if (cases.length === 0) { %>
        <div class="empty-state">
          <p>No cases match.</p>
          <a href="/cases/new" class="btn">Add a case</a>
        </div>
      <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Date</th><th>Category</th><th>Patient</th><th>Age</th><th>Procedure</th><th>Role</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% cases.forEach(function(c) { %>
          <tr>
            <td><%= c.date_of_service || '—' %></td>
            <td><% if (c.section) { %><span class="badge section-<%= c.section.replace(/\s+/g, '') %>"><%= c.category_name %></span><% } else { %>—<% } %></td>
            <td><%= c.patient_ref || c.patient_initials || '—' %></td>
            <td><%= c.age || '—' %></td>
            <td><%= c.procedure_text || '—' %></td>
            <td><%= c.role || '—' %></td>
            <td><a href="/cases/<%= c.id %>">View</a> · <a href="/cases/<%= c.id %>/edit">Edit</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
  <script src="/js/categorySelect.js"></script>
</body>
</html>
