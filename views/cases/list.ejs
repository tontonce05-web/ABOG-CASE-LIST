<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="container">
    <div class="section-header">
      <h1>Case List <span class="count-chip"><%= cases.length %></span></h1>
      <a href="/cases/new" class="btn">+ Add Case</a>
    </div>

    <form method="GET" action="/cases" class="filters">
      <input type="text" name="q" placeholder="Search initials, diagnosis, procedure..." value="<%= q %>" />
      <select name="category">
        <option value="">All categories</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat.id %>" <%= String(filterCategory) === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
        <% }); %>
      </select>
      <button type="submit" class="btn-secondary btn-small">Filter</button>
      <% if (q || filterCategory) { %><a href="/cases" class="btn-small btn-secondary">Clear</a><% } %>
    </form>

    <div class="card table-card">
      <% if (cases.length === 0) { %>
        <div class="empty-state">
          <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <p>No cases match.</p>
          <a href="/cases/new" class="btn">Add a case</a>
        </div>
      <% } else { %>
      <table class="responsive-table">
        <thead>
          <tr>
            <th>Date</th><th>Category</th><th>Initials</th><th>Age</th><th>Procedure</th><th>Role</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% cases.forEach(function(c) { %>
          <tr>
            <td data-label="Date"><%= c.date_of_service || '—' %></td>
            <td data-label="Category"><% if (c.section) { %><span class="badge section-<%= c.section %>"><%= c.category_name %></span><% } else { %>—<% } %></td>
            <td data-label="Initials"><%= c.patient_initials || '—' %></td>
            <td data-label="Age"><%= c.age || '—' %></td>
            <td data-label="Procedure"><%= c.procedure_text || '—' %></td>
            <td data-label="Role"><%= c.role || '—' %></td>
            <td data-label=""><a href="/cases/<%= c.id %>">View</a> · <a href="/cases/<%= c.id %>/edit">Edit</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</body>
</html>
