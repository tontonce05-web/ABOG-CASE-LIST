<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="container">
    <div class="section-header">
      <h1>Study &amp; References <span class="count-chip"><%= topics.length %></span></h1>
      <a href="/study/new" class="btn btn-secondary btn-small">+ Add topic</a>
    </div>
    <div class="alert alert-info">
      These are condensed, original study summaries meant as a quick refresher, citing the specialty guidance they're based on — they are <strong>not</strong> a substitute for reading the current primary source. Guidelines change; verify anything high-stakes against the live ACOG/SMFM/CDC/ASCCP/WPSI/NAMS/ASRM document before relying on it for patient care or boards.
    </div>

    <form method="GET" action="/study" class="filters">
      <input type="text" name="q" placeholder="Search topics..." value="<%= q %>" />
      <select name="section">
        <option value="">All sections</option>
        <% sections.forEach(function(s) { %>
          <option value="<%= s %>" <%= filterSection === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
      <button type="submit" class="btn-secondary btn-small">Filter</button>
      <% if (q || filterSection) { %><a href="/study" class="btn-small btn-secondary">Clear</a><% } %>
    </form>

    <% if (topics.length === 0) { %>
      <div class="card">
        <div class="empty-state">
          <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H18a1 1 0 0 1 1 1v17a1 1 0 0 1-1 1H6.5A2.5 2.5 0 0 1 4 18.5v-14Z"/><path d="M8 7h8M8 11h8M8 15h5"/></svg>
          <p>No topics yet.</p>
          <a href="/study/new" class="btn">Add the first one</a>
        </div>
      </div>
    <% } else { %>
      <div class="topic-grid">
        <% topics.forEach(function(t) { %>
          <a href="/study/<%= t.id %>" class="topic-card">
            <span class="badge section-<%= t.section.replace(/\s+/g, '-') %>"><%= t.section %></span>
            <h3><%= t.title %></h3>
            <p class="small muted"><%= t.summary || '' %></p>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>
