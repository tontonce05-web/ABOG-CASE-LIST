<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="container">
    <h1><%= title %></h1>
    <% var isEdit = topic && topic.id; %>

    <form method="POST" action="<%= isEdit ? '/study/' + topic.id : '/study' %>" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="form-grid">
        <div class="field-group full">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" required value="<%= topic.title || '' %>" />
        </div>
        <div class="field-group">
          <label for="section">Section</label>
          <select id="section" name="section">
            <option value="Obstetrics" <%= topic.section === 'Obstetrics' ? 'selected' : '' %>>Obstetrics</option>
            <option value="Gynecology" <%= topic.section === 'Gynecology' ? 'selected' : '' %>>Gynecology</option>
            <option value="Preventive Care" <%= topic.section === 'Preventive Care' ? 'selected' : '' %>>Preventive Care</option>
            <option value="Other" <%= topic.section === 'Other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>
        <div class="field-group">
          <label for="last_reviewed">Last reviewed</label>
          <input type="date" id="last_reviewed" name="last_reviewed" value="<%= topic.last_reviewed || '' %>" />
        </div>
        <div class="field-group full">
          <label for="summary">One-line summary (shown in the topic list)</label>
          <input type="text" id="summary" name="summary" value="<%= topic.summary || '' %>" />
        </div>
        <div class="field-group full">
          <label for="key_points">Key points — one per line</label>
          <textarea id="key_points" name="key_points" rows="6" placeholder="One high-yield fact per line"><%= topic.key_points || '' %></textarea>
        </div>
        <div class="field-group full">
          <label for="management">Management — one step per line</label>
          <textarea id="management" name="management" rows="6" placeholder="One management step per line, in order"><%= topic.management || '' %></textarea>
        </div>
        <div class="field-group full">
          <label for="citations">Sources — one per line</label>
          <textarea id="citations" name="citations" rows="3" placeholder="e.g. ACOG Practice Bulletin, [title] (current edition — verify at acog.org)"><%= topic.citations || '' %></textarea>
        </div>
      </div>
      <div class="actions">
        <button type="submit" class="btn">Save topic</button>
        <a href="<%= isEdit ? '/study/' + topic.id : '/study' %>" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
