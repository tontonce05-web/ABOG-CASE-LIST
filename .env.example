# Copy this file to .env and adjust for your deployment.

# Port the app listens on
PORT=3000

# Secret used to sign session cookies. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-value

# Set to "true" when running behind HTTPS (e.g. behind an AWS load balancer
# or CloudFront). This makes session cookies "secure" (HTTPS only).
TRUST_PROXY=false
COOKIE_SECURE=false

# Where the SQLite database file lives. On AWS, point this at a mounted
# EFS volume (or an EBS-backed volume) so data survives redeploys.
DATA_DIR=./data

# Optional: bcrypt hash of the access PIN. If unset, the app initializes
# itself on first run with the default PIN 1732 (hashed) and you should
# change it immediately from the in-app Settings page.
# Generate one with: node scripts/hash-pin.js <your-pin>
# PIN_HASH=
